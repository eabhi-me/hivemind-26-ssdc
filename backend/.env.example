# HiveMind 2026 Flask Backend Environment Configuration

# MongoDB Connection String
# Local MongoDB: mongodb://localhost:27017/hivemind_db
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/hivemind_db
MONGO_URI=mongodb://localhost:27017/hivemind_db

# Secret Key for JWT Tokens
JWT_SECRET=hivemind_super_secret_jwt_key_2026_ssdc

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Server Port
PORT=5000
